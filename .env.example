# Application Configuration
APP_NAME=Local-AI-RAG
APP_VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=llama3.2:3b
OLLAMA_SCOUT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=120

# Embeddings Configuration
# Options: "ollama" or "sentence-transformers"
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=768

# Vector Database Configuration
# Options: "chromadb" or "sqlite"
VECTOR_DB_TYPE=chromadb
CHROMA_PERSIST_DIRECTORY=./data/chroma

# SQLite Database
DATABASE_PATH=./data/app.db

# Google Custom Search API (Optional - for Scout feature)
# If not configured, Scout will use web scraping as fallback
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here
SEARCH_MAX_RESULTS=5
USE_WEB_SCRAPING_FALLBACK=true

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Scout Configuration
SCOUT_UNCERTAINTY_THRESHOLD=0.6
SCOUT_ENABLED=true

# AI Firewall Configuration
FIREWALL_ENABLED=true

# CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
